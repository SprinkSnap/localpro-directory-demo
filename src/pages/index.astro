---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSearch from "@/components/islands/HeroSearch";
import ProviderCard from "@/components/directory/ProviderCard.astro";
import CategoryIcon from "@/components/ui/CategoryIcon.astro";
import { getDirectoryRepository } from "@/db/repository";
import { HOME_FAQS } from "@/data/faqs";
import { getPublicEnv, SITE } from "@/lib/config";
import { faqJsonLd, organizationJsonLd, websiteJsonLd } from "@/lib/seo";

export const prerender = true;

const repo = getDirectoryRepository();
const categories = repo.listCategories();
const areas = repo.listAreas();
const featured = repo.getFeatured(6);
const popular = categories.slice(0, 8).map((c) => ({
  ...c,
  count: repo.countByCategory(c.id),
}));
const env = getPublicEnv();

const showcase = [
  { title: "Fast search", body: "Server-side queries with URL state, suggestions and clear empty states." },
  { title: "Useful filters", body: "Category, service, area, business type, completeness and portfolio signals." },
  { title: "Clear listing cards", body: "Concept labels, service summaries and actions without fake trust badges." },
  { title: "Side-by-side comparison", body: "Compare up to three profiles on criteria that are actually available." },
  { title: "Saved providers", body: "Local saved lists with no account requirement and accessible announcements." },
  { title: "Accessible quote requests", body: "A multistep demonstration that never transmits a real enquiry." },
  { title: "Mobile-first interaction", body: "Large targets, sticky utility patterns and keyboard-safe drawers." },
];

const studioPoints = [
  "Directory architecture",
  "Indexed database search",
  "Programmatic page generation",
  "Conversion-focused listing pages",
  "Multi-provider enquiry flows",
  "Business onboarding",
  "Responsive images",
  "Technical SEO",
  "Edge caching",
  "Accessible interactions",
];

const jsonLd = [
  organizationJsonLd(env.siteUrl),
  websiteJsonLd(env.siteUrl, false),
  faqJsonLd(HOME_FAQS),
];
---

<BaseLayout
  title="Find Local Professionals Faster"
  description="LocalPro Directory is a fictional local-services discovery and quote-request platform concept by Che Xu Studio—built to demonstrate search, listings, SEO and lead generation."
  path="/"
  jsonLd={jsonLd}
>
  <section class="surface-hero border-b border-navy/10">
    <div class="container-page grid gap-10 py-12 md:py-16 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div class="animate-slide-up">
        <p class="eyebrow">Local Services, Easier to Find</p>
        <h1 class="mt-3 font-display text-display-md text-navy md:text-display-lg xl:text-display-xl">
          Find the Right Local Professional, Faster.
        </h1>
        <p class="prose-demo mt-5 text-lg">
          Search by service and area, compare clear profiles and explore a streamlined quote-request experience.
        </p>
        <div class="mt-8">
          <HeroSearch
            client:load
            categories={categories.map((c) => ({ slug: c.slug, name: c.name }))}
            areas={areas.map((a) => ({ slug: a.slug, name: a.name }))}
          />
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/categories/" class="btn-secondary">Browse Categories</a>
          <a href="/submit-listing/" class="btn-ghost">List Your Business</a>
        </div>
        <p class="mt-4 text-xs text-muted">
          Fictional directory demonstration—no real provider or quote request is involved.
        </p>
      </div>
      <div class="relative hidden lg:block">
        <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-bright/20 via-teal/10 to-transparent"></div>
        <div class="relative overflow-hidden rounded-[1.5rem] border border-navy/10 bg-navy p-8 text-white shadow-raised">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-bright">LocalPro</p>
          <p class="mt-3 font-display text-3xl font-bold leading-tight">
            {SITE.tagline}
          </p>
          <ul class="mt-8 space-y-4 text-sm text-white/85">
            <li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-teal" aria-hidden="true"></span>Indexed search without shipping the full dataset</li>
            <li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-bright" aria-hidden="true"></span>Comparison, saved lists and quote-request demos</li>
            <li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-amber" aria-hidden="true"></span>Responsible SEO architecture for verified real data later</li>
          </ul>
          <button type="button" class="btn mt-8 bg-white text-navy hover:bg-cloud" data-open-enquiry>
            Build a Directory Like This
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="categories-heading">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Popular categories</p>
        <h2 id="categories-heading" class="mt-2 font-display text-display-sm text-navy md:text-display-md">
          Start with the service you need
        </h2>
        <p class="prose-demo mt-3">Eight high-intent local-service categories with clearly labelled demonstration listing counts.</p>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          popular.map((category) => (
            <li>
              <a href={`/categories/${category.slug}/`} class="card-interactive block h-full">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-search-light text-search">
                  <CategoryIcon name={category.icon} />
                </span>
                <h3 class="mt-4 font-display text-lg font-semibold text-navy">{category.name}</h3>
                <p class="mt-2 text-sm text-muted">{category.shortDescription}</p>
                <p class="mt-4 text-xs font-semibold text-navy">
                  <span class="tabular">{category.count}</span> sample listings
                  <span class="font-normal text-muted"> (demonstration data)</span>
                </p>
                <span class="mt-3 inline-flex text-sm font-semibold text-search">View category</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="how-heading">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">How LocalPro works</p>
        <h2 id="how-heading" class="mt-2 font-display text-display-sm text-navy md:text-display-md">
          A clear path from search to next step
        </h2>
      </div>
      <ol class="mt-8 grid gap-4 md:grid-cols-4">
        {
          [
            ["Choose a service", "Start with a category, keyword or popular service."],
            ["Refine your search", "Use filters for area, business type and profile completeness."],
            ["Compare professionals", "Save listings and compare up to three concept profiles."],
            ["Complete the quote-request demonstration", "Walk through a multistep enquiry flow without sending real requests."],
          ].map(([title, body], index) => (
            <li class="rounded-xl border border-navy/10 bg-cloud p-5">
              <p class="tabular text-sm font-bold text-search">0{index + 1}</p>
              <h3 class="mt-3 font-display text-lg font-semibold text-navy">{title}</h3>
              <p class="mt-2 text-sm text-muted">{body}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-8">
        <a href="/how-it-works/" class="btn-secondary">See how it works</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-heading">
    <div class="container-page">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">Featured fictional professionals</p>
          <h2 id="featured-heading" class="mt-2 font-display text-display-sm text-navy md:text-display-md">
            Concept profiles built for clarity
          </h2>
          <p class="prose-demo mt-3">
            No ratings, reviews, licences or verification badges—only transparent demonstration data.
          </p>
        </div>
        <a href="/search/?featured=1" class="btn-primary">Browse featured demos</a>
      </div>
      <ul class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {featured.map((provider) => (
          <li>
            <ProviderCard provider={provider} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-navy text-white" aria-labelledby="showcase-heading">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow text-bright">Search and comparison</p>
        <h2 id="showcase-heading" class="mt-2 font-display text-display-sm md:text-display-md">
          Designed to Make Complex Choices Feel Simple.
        </h2>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          showcase.map((item) => (
            <li class="rounded-xl border border-white/10 bg-white/5 p-5">
              <h3 class="font-display text-lg font-semibold">{item.title}</h3>
              <p class="mt-2 text-sm text-white/75">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="areas-heading">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Service-area navigation</p>
        <h2 id="areas-heading" class="mt-2 font-display text-display-sm text-navy md:text-display-md">
          Browse by fictional district
        </h2>
        <p class="prose-demo mt-3">
          Area pages demonstrate neighbourhood discovery without real addresses or geographic coordinates.
        </p>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          areas.slice(0, 5).map((area) => (
            <li>
              <a href={`/areas/${area.slug}/`} class="card-interactive block h-full">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-teal">{area.districtGroup}</p>
                <h3 class="mt-2 font-display text-xl font-semibold text-navy">{area.name}</h3>
                <p class="mt-2 text-sm text-muted">{area.shortDescription}</p>
                <p class="mt-4 text-xs font-semibold text-navy">
                  <span class="tabular">{repo.countByArea(area.id)}</span> sample listings
                </p>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-8">
        <a href="/areas/" class="btn-secondary">View all areas</a>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="business-heading">
    <div class="container-page grid gap-8 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">For businesses</p>
        <h2 id="business-heading" class="mt-2 font-display text-display-sm text-navy md:text-display-md">
          Help Customers Understand What Your Business Offers.
        </h2>
        <p class="prose-demo mt-4">
          Demonstrate business profiles, service categories, service areas, portfolio images, enquiry routing, profile analytics and featured-placement architecture.
        </p>
        <a href="/for-business/" class="btn-primary mt-6">Explore the Business Experience</a>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          [
            "Business profile",
            "Service categories",
            "Service areas",
            "Portfolio images",
            "Enquiry routing",
            "Profile analytics",
            "Featured-placement architecture",
            "Illustrative plan comparison",
          ].map((item) => (
            <li class="rounded-lg border border-navy/10 bg-cloud px-4 py-3 text-sm font-semibold text-navy">
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="studio-heading">
    <div class="container-page rounded-2xl border border-navy/10 bg-gradient-to-br from-white via-cloud to-search-light/40 p-8 md:p-12">
      <p class="eyebrow">Che Xu Studio</p>
      <h2 id="studio-heading" class="mt-2 max-w-3xl font-display text-display-sm text-navy md:text-display-md">
        Built for Search, Scale and Lead Generation.
      </h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {
          studioPoints.map((point) => (
            <li class="rounded-lg border border-navy/10 bg-white/80 px-3 py-3 text-sm font-medium text-navy">
              {point}
            </li>
          ))
        }
      </ul>
      <button type="button" class="btn-accent mt-8" data-open-enquiry>
        Build This for My Business
      </button>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="faq-heading">
    <div class="container-page max-w-3xl">
      <h2 id="faq-heading" class="font-display text-display-sm text-navy md:text-display-md">
        Frequently asked questions
      </h2>
      <div class="mt-8 space-y-3">
        {
          HOME_FAQS.map((faq) => (
            <details class="group rounded-xl border border-navy/10 bg-cloud px-5 py-4">
              <summary class="cursor-pointer list-none font-semibold text-navy marker:content-none">
                <span class="flex items-center justify-between gap-4">
                  {faq.question}
                  <span class="text-search transition group-open:rotate-45" aria-hidden="true">+</span>
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-muted">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="final-cta-heading">
    <div class="container-page text-center">
      <h2 id="final-cta-heading" class="font-display text-display-sm text-navy md:text-display-md">
        Have a Directory or Marketplace Idea?
      </h2>
      <p class="prose-demo mx-auto mt-4">
        Che Xu Studio can design and build a fast, scalable platform that makes information easier to discover and turns searches into qualified enquiries.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <button type="button" class="btn-primary" data-open-enquiry>Request My Platform Plan</button>
        <a href={env.packagesUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">
          View Che Xu Studio Packages
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
