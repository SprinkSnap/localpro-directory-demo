---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";

export const prerender = true;

const features = [
  {
    title: "Business profile pages",
    body: "Structured profiles with concept labels, service summaries, portfolio images and clear disclosure that listings are fictional demonstration data.",
  },
  {
    title: "Service and area placement",
    body: "Category, service and fictional district navigation so customers can discover businesses through high-intent browse and search paths.",
  },
  {
    title: "Portfolio and completeness signals",
    body: "Visual portfolio galleries and profile-completeness indicators that help comparison without fake trust badges or review scores.",
  },
  {
    title: "Enquiry routing architecture",
    body: "Demonstration of how quote requests could be routed to providers—with transparent labelling that no real enquiry is sent in this demo.",
  },
  {
    title: "Profile analytics (demo)",
    body: "Illustrative analytics views showing how a business dashboard might surface views, saves and enquiry patterns over time.",
  },
  {
    title: "Featured placement labelling",
    body: "Sponsored and featured listings are clearly marked as demonstration placements, not endorsements or paid rankings.",
  },
];
---

<BaseLayout
  title="For Businesses"
  description="Explore the fictional LocalPro Directory business experience—profiles, analytics, featured placement and illustrative listing plans for local-service providers."
  path="/for-business/"
>
  <section class="surface-hero border-b border-navy/10">
    <div class="container-page py-12 md:py-16">
      <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "For businesses" }]} />
      <p class="eyebrow">For businesses</p>
      <h1 class="mt-3 max-w-3xl font-display text-display-md text-navy md:text-display-lg">
        Help customers understand what your business offers
      </h1>
      <p class="prose-demo mt-5 text-lg">
        This section demonstrates how a local-services directory could support business profiles, discovery, lead routing and growth tools—all using fictional data and clearly labelled concept interactions.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/for-business/plans/" class="btn-primary">View illustrative plans</a>
        <a href="/submit-listing/" class="btn-secondary">Submit listing demo</a>
      </div>
      <p class="mt-4 text-xs text-muted">
        No real business onboarding, subscription or listing purchase is available in this portfolio demonstration.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Business experience</p>
        <h2 class="mt-2 font-display text-display-sm text-navy md:text-display-md">
          What a real directory could offer providers
        </h2>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <li class="rounded-xl border border-navy/10 bg-white p-5 shadow-soft">
              <h3 class="font-display text-lg font-semibold text-navy">{feature.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{feature.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page grid gap-8 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">Get started (demo)</p>
        <h2 class="mt-2 font-display text-display-sm text-navy md:text-display-md">
          Try the listing submission and claim flows
        </h2>
        <p class="prose-demo mt-4">
          Walk through how a business might submit a new listing or claim an existing fictional profile. Both flows are demonstrations only—they do not create real listings or contact providers.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/submit-listing/" class="btn-primary">Submit listing demo</a>
          <a href="/claim-listing/" class="btn-secondary">Claim listing demo</a>
        </div>
      </div>
      <div class="card-interactive">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-teal">Illustrative plans</p>
        <h3 class="mt-2 font-display text-xl font-semibold text-navy">Basic, Professional and Featured</h3>
        <p class="mt-3 text-sm text-muted">
          Compare fictional monthly and annual pricing, portfolio limits and feature tiers. Plans are for demonstration purposes only.
        </p>
        <a href="/for-business/plans/" class="btn-secondary mt-6">Compare plans</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page rounded-2xl border border-navy/10 bg-gradient-to-br from-white via-cloud to-search-light/40 p-8 text-center md:p-12">
      <h2 class="font-display text-display-sm text-navy md:text-display-md">
        Build a business directory for your market
      </h2>
      <p class="prose-demo mx-auto mt-4">
        Che Xu Studio can design provider onboarding, plan tiers, SEO architecture and lead-generation flows tailored to your niche.
      </p>
      <button type="button" class="btn-accent mt-8" data-open-enquiry>
        Build This for My Business
      </button>
    </div>
  </section>
</BaseLayout>
