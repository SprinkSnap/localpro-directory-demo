---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProviderCard from "@/components/directory/ProviderCard.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import CategoryIcon from "@/components/ui/CategoryIcon.astro";
import { getDirectoryRepository } from "@/db/repository";
import { CATEGORIES } from "@/data/categories";
import { passesIndexQualityGate } from "@/lib/seo";
import { getPublicEnv } from "@/lib/config";

export const prerender = true;

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
  }));
}

const repo = getDirectoryRepository();
const slug = Astro.params.category!;
const category = repo.getCategory(slug);
if (!category) {
  return Astro.redirect("/404/");
}

const services = repo.listServices(slug);
const result = repo.search({ category: slug, sort: "profile-completeness", limit: 12 });
const relatedAreas = repo.listAreas().slice(0, 5);
const env = getPublicEnv();
const intro = category.longDescription;
const canIndex = passesIndexQualityGate(env.demoMode, {
  introLength: intro.length,
  providerCount: result.total,
  hasUniqueLocalInfo: true,
  hasRequiredMetadata: true,
  areaOrCategoryVerified: false,
});
---

<BaseLayout
  title={`${category.name} Professionals`}
  description={`${category.shortDescription} Browse fictional ${category.name.toLowerCase()} professionals in LocalPro Directory.`}
  path={`/categories/${category.slug}/`}
  noindex={!canIndex}
>
  <section class="section pt-10">
    <div class="container-page">
      <Breadcrumbs
        items={[
          { name: "Home", path: "/" },
          { name: "Categories", path: "/categories/" },
          { name: category.name },
        ]}
      />
      <div class="flex items-start gap-4">
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-search-light text-search">
          <CategoryIcon name={category.icon} class="h-7 w-7" />
        </span>
        <div>
          <p class="eyebrow">Category</p>
          <h1 class="mt-1 font-display text-display-sm text-navy md:text-display-md">{category.name}</h1>
        </div>
      </div>
      <p class="prose-demo mt-4">{intro}</p>
      <p class="mt-3 text-sm font-semibold text-navy">
        <span class="tabular">{result.total}</span> sample listings
        <span class="font-normal text-muted"> (demonstration data)</span>
      </p>

      <div class="mt-8">
        <h2 class="font-display text-xl font-semibold text-navy">Services in this category</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            services.map((service) => (
              <li>
                <a
                  href={`/search/?category=${category.slug}&service=${service.slug}`}
                  class="rounded-md border border-navy/10 bg-white px-3 py-2 text-sm font-semibold text-navy hover:border-search/30"
                >
                  {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <h2 class="font-display text-xl font-semibold text-navy">Featured concept profiles</h2>
          <a href={`/search/?category=${category.slug}`} class="btn-secondary">View all in search</a>
        </div>
        <ul class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {result.items.map((provider) => (
            <li><ProviderCard provider={provider} /></li>
          ))}
        </ul>
      </div>

      <div class="mt-12 rounded-xl border border-navy/10 bg-white p-6">
        <h2 class="font-display text-xl font-semibold text-navy">Explore by area</h2>
        <p class="mt-2 text-sm text-muted">
          Category-plus-area combinations are available through search. In a verified real directory, each indexable combination would need unique content and a quality gate.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            relatedAreas.map((area) => (
              <li>
                <a
                  href={`/search/?category=${category.slug}&area=${area.slug}`}
                  class="btn-ghost min-h-10"
                >
                  {category.name} in {area.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
