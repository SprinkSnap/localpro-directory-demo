---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CategoryIcon from "@/components/ui/CategoryIcon.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import { getDirectoryRepository } from "@/db/repository";
import { itemListJsonLd } from "@/lib/seo";
import { getPublicEnv } from "@/lib/config";

export const prerender = true;

const repo = getDirectoryRepository();
const categories = repo.listCategories();
const env = getPublicEnv();
const jsonLd = itemListJsonLd(
  "LocalPro Directory categories",
  categories.map((c) => ({ name: c.name, path: `/categories/${c.slug}/` })),
  env.siteUrl,
);
---

<BaseLayout
  title="Service Categories"
  description="Browse fictional LocalPro Directory service categories including home services, creative services and local support categories."
  path="/categories/"
  jsonLd={jsonLd}
>
  <section class="section pt-10">
    <div class="container-page">
      <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Categories" }]} />
      <p class="eyebrow">Categories</p>
      <h1 class="mt-2 font-display text-display-sm text-navy md:text-display-md">
        Browse service categories
      </h1>
      <p class="prose-demo mt-3">
        Eighteen safe local-service categories used to demonstrate directory navigation and search refinement.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((category) => (
            <li>
              <a href={`/categories/${category.slug}/`} class="card-interactive block h-full">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-search-light text-search">
                  <CategoryIcon name={category.icon} />
                </span>
                <h2 class="mt-4 font-display text-xl font-semibold text-navy">{category.name}</h2>
                <p class="mt-2 text-sm text-muted">{category.shortDescription}</p>
                <p class="mt-4 text-xs font-semibold text-navy">
                  <span class="tabular">{repo.countByCategory(category.id)}</span> sample listings
                  <span class="font-normal text-muted"> (demonstration data)</span>
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
