---
interface Props {
  class?: string;
  compact?: boolean;
}
const { class: className = "", compact = false } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg
    class="h-9 w-9 shrink-0"
    viewBox="0 0 48 48"
    role="img"
    aria-labelledby="localpro-logo-title"
  >
    <title id="localpro-logo-title">LocalPro Directory</title>
    <rect width="48" height="48" rx="12" fill="#10243E"></rect>
    <path
      d="M24 10c-6.2 0-11 4.7-11 10.6 0 7.4 9.1 15.7 10.5 16.9a.8.8 0 0 0 1 0C25.9 36.3 35 28 35 20.6 35 14.7 30.2 10 24 10Z"
      fill="#4F8CFF"></path>
    <circle cx="24" cy="20.5" r="4.2" fill="#FFFFFF"></circle>
    <path
      d="M16 38.5h16"
      stroke="#13998F"
      stroke-width="2.5"
      stroke-linecap="round"></path>
    <path
      d="M19.5 34.5h9"
      stroke="#246BFD"
      stroke-width="2"
      stroke-linecap="round"
      opacity="0.85"></path>
  </svg>
  {
    !compact && (
      <span class="leading-tight">
        <span class="block font-display text-lg font-bold tracking-tight text-navy">LocalPro</span>
        <span class="block text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-muted">
          Directory
        </span>
      </span>
    )
  }
</span>
