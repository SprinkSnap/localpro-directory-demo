---
import type { ProviderCard } from "@/lib/types";
import ProviderActions from "@/components/islands/ProviderActions";

interface Props {
  provider: ProviderCard;
  showSponsored?: boolean;
}
const { provider, showSponsored = true } = Astro.props;
const thumb = provider.portfolioImages[0];
---

<article class="card-interactive flex h-full flex-col gap-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="mb-2 flex flex-wrap gap-2">
        <span class="status-concept">
          <span aria-hidden="true">◇</span>
          {provider.conceptLabel}
        </span>
        {
          showSponsored && provider.sponsoredDemo && (
            <span class="status-sponsored">
              <span class="sr-only">Label: </span>
              Sponsored demo placement
            </span>
          )
        }
        {
          provider.hasPortfolio && (
            <span class="status-portfolio">
              <span aria-hidden="true">▣</span>
              Portfolio available
            </span>
          )
        }
      </div>
      <h3 class="font-display text-lg font-semibold tracking-tight text-navy">
        <a href={`/professionals/${provider.slug}/`} class="hover:text-search">
          {provider.name}
        </a>
      </h3>
      <p class="mt-1 text-sm text-muted">
        {provider.primaryCategoryName}
        <span aria-hidden="true"> · </span>
        <span>{provider.areaNames.slice(0, 2).join(", ")}</span>
      </p>
    </div>
    {
      thumb ? (
        <img
          src={thumb.src}
          alt={thumb.alt}
          width="72"
          height="54"
          loading="lazy"
          decoding="async"
          class="h-14 w-[4.5rem] shrink-0 rounded-md object-cover"
        />
      ) : (
        <div
          class="flex h-14 w-[4.5rem] shrink-0 items-center justify-center rounded-md bg-navy/5 text-xs font-semibold text-muted"
          aria-hidden="true"
        >
          Demo
        </div>
      )
    }
  </div>

  <p class="text-sm leading-relaxed text-charcoal/90">{provider.shortDescription}</p>

  <div class="mt-auto space-y-3">
    <div>
      <div class="mb-1 flex items-center justify-between text-xs">
        <span class="font-semibold text-navy">Profile completeness</span>
        <span class="tabular text-muted">{provider.profileCompleteness}%</span>
      </div>
      <div
        class="h-2 overflow-hidden rounded-full bg-navy/10"
        role="meter"
        aria-label={`Profile completeness ${provider.profileCompleteness} percent`}
        aria-valuemin={0}
        aria-valuemax={100}
        aria-valuenow={provider.profileCompleteness}
      >
        <div
          class="h-full rounded-full bg-teal"
          style={`width:${provider.profileCompleteness}%`}
        ></div>
      </div>
    </div>

    <ProviderActions
      client:visible
      providerId={provider.id}
      providerSlug={provider.slug}
      providerName={provider.name}
    />
  </div>
</article>
