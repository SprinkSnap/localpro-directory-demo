{
  "name": "localpro-directory-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LocalPro Directory — fictional local-services directory portfolio demonstration by Che Xu Studio",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "db:migrate:local": "wrangler d1 migrations apply localpro-directory --local",
    "db:seed:local": "tsx scripts/seed-d1.ts --local",
    "db:reset:local": "npm run db:migrate:local && npm run db:seed:local",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "wrangler:dry-run": "wrangler deploy --dry-run --outdir=.wrangler-dry-run",
    "loadtest:local": "tsx scripts/load-test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^5.18.2",
    "clsx": "^2.1.1",
    "nanoid": "^5.1.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0"
  }
}
